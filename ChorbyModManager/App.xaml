<Application x:Class="ChorbyModManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ChorbyModManager"
             xmlns:viewModel="clr-namespace:ChorbyModManager.Views.Model"
             xmlns:view="clr-namespace:ChorbyModManager.Views.View"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="LogoFont">/Assets/Fonts/#Bebas Neue Regular</FontFamily>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/NavButtonTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <DataTemplate DataType="{x:Type viewModel:LibraryViewModel}"> <!-- what -->
            <view:LibraryView/>
        </DataTemplate>
    </Application.Resources>
</Application>
