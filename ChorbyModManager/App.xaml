<Application x:Class="ChorbyModManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ChorbyModManager"
             xmlns:viewModel="clr-namespace:ChorbyModManager.Views.Model"
             xmlns:view="clr-namespace:ChorbyModManager.Views.View"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/NavButtonTheme.xaml"/>
                <ResourceDictionary Source="/Themes/SearchBoxTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="LogoFont">/Assets/Fonts/#Bebas Neue Regular</FontFamily>

            <DataTemplate DataType="{x:Type viewModel:LibraryViewModel}">
                <view:LibraryView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
