<Window x:Class="ChorbyModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChorbyModManager"
        xmlns:viewModel="clr-namespace:ChorbyModManager.Views.Model"
        mc:Ignorable="d"
        Title="Chorby Mod Manager" 
        Height="600" 
        Width="800"
        MinHeight="200"
        MinWidth="600"
        WindowState="Maximized"
        PreviewMouseDown="ClearFocus">

    <Window.DataContext>
        <viewModel:MainViewModel/>
    </Window.DataContext>
    
    <Border Background="#262626">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="185"/>
                <ColumnDefinition Width="70*"/>
                <ColumnDefinition Width="30*"/>
            </Grid.ColumnDefinitions>

            <Border CornerRadius="10" Background="#3F3F3F" HorizontalAlignment="Left" Margin="8" Padding="10,5">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/Images/ChorbyTransparent.png" HorizontalAlignment="Left" Margin="5"/>
                    <TextBlock Text="Chorby Mod&#x0a;Manager" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="White" FontFamily="{DynamicResource LogoFont}" />
                </StackPanel>
            </Border>

            <UniformGrid Rows="1" Grid.Column="1">
                <RadioButton Content="Library" Style="{StaticResource NavButtonTheme}" IsChecked="True" Checked="RadioButton_Checked_2"/>
                <RadioButton Content="Browser" Style="{StaticResource NavButtonTheme}"/>
                <RadioButton Content="Options" Style="{StaticResource NavButtonTheme}"/>
                <RadioButton Content="About" Style="{StaticResource NavButtonTheme}"/>
            </UniformGrid>

            <Border Grid.Column="2" CornerRadius="10" Margin="8" Background="#00B107" HorizontalAlignment="Right">
                <Button Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/start.png" Margin="12,15" Height="36" VerticalAlignment="Center"/>
                        <TextBlock Text="Start Game&#x0a;0 Mods" TextAlignment="Center" Margin="12,0" VerticalAlignment="Center" FontSize="24" FontFamily="{DynamicResource LogoFont}"/>
                    </StackPanel>
                </Button>
            </Border>

            <ContentControl Content="{Binding CurrentView}" Grid.Row="1" Grid.ColumnSpan="3" Margin="12"/>
        </Grid>
    </Border>
</Window>
