<UserControl x:Class="ChorbyModManager.Views.View.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ChorbyModManager.Views.View"
             mc:Ignorable="d" 
             d:DesignHeight="370" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="85*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="95*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="5"/> <!-- should be same as height!> -->
                <ColumnDefinition Width="{Binding Height, RelativeSource={RelativeSource AncestorType=Grid}}"/>
                <ColumnDefinition Width="50*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#3f3f3f" CornerRadius="4">
                <TextBlock Text="Search..." Padding="16" VerticalAlignment="Center" Foreground="White"/>
            </Border>

            <Border CornerRadius="4" Background="red" Grid.Column="1">
                <Button Background="Transparent" BorderThickness="0">
                    <TextBlock Text="TMP FILTER IMG" TextAlignment="Center" FontSize="17" FontFamily="{DynamicResource LogoFont}"/>
                </Button>
            </Border>

            <Border CornerRadius="4" Background="red" Grid.Column="2">
                <Button Background="Transparent" BorderThickness="0">
                    <TextBlock Text="TMP SORT TYPE IMG" TextAlignment="Center" FontSize="17" FontFamily="{DynamicResource LogoFont}"/>
                </Button>
            </Border>
        </Grid>

        <UniformGrid Grid.Row="2" Columns="5">
            <!-- downloaded items shown here with their info and such (buttons to enable/disable/pin/delete, icon, title, author, etc..) -->
        </UniformGrid> <!-- pinned mods also store the icon (not banner) to save on connection when reloading the manager and see the icon even while offline -->

        <TextBlock Foreground="White" Text="Downloaded: 0 Enabled: 0 Disabled: 0" Grid.Row="1"/>

        <ScrollBar Grid.Column="2" Grid.Row="2" Margin="10"></ScrollBar>
    </Grid>
</UserControl>
